<?xml version="1.0" encoding="utf-8"?>
<!-- Static source for the splash AVD. The lens ring and the three connectors are
     named so the animator can trim them on; the splash mask on API 31+ crops to
     a circle, so all geometry stays well inside the safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:name="ring"
        android:pathData="M 54,28 a 26,26 0 1,1 -0.01,0 z"
        android:strokeColor="#FF7C93FF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />

    <path
        android:name="spoke_top"
        android:pathData="M 54,42 L 54,32.5"
        android:strokeColor="#FF5B72E8" android:strokeWidth="2.2" android:strokeLineCap="round" />
    <path
        android:name="spoke_right"
        android:pathData="M 64.4,60 L 72.6,64.8"
        android:strokeColor="#FF5B72E8" android:strokeWidth="2.2" android:strokeLineCap="round" />
    <path
        android:name="spoke_left"
        android:pathData="M 43.6,60 L 35.4,64.8"
        android:strokeColor="#FF5B72E8" android:strokeWidth="2.2" android:strokeLineCap="round" />

    <group android:name="aperture_group" android:pivotX="54" android:pivotY="54">
        <path
            android:name="aperture"
            android:pathData="M 44,54 a 10,10 0 1,0 20,0 a 10,10 0 1,0 -20,0 z"
            android:fillColor="#FF6E86F5" />
    </group>

    <group android:name="nodes_group" android:pivotX="54" android:pivotY="54">
        <path android:name="node_top"
            android:pathData="M 49.5,28 a 4.5,4.5 0 1,0 9,0 a 4.5,4.5 0 1,0 -9,0 z"
            android:fillColor="#FFE8ECFF" />
        <path android:name="node_right"
            android:pathData="M 72,67 a 4.5,4.5 0 1,0 9,0 a 4.5,4.5 0 1,0 -9,0 z"
            android:fillColor="#FF8FA3FF" />
        <path android:name="node_left"
            android:pathData="M 27,67 a 4.5,4.5 0 1,0 9,0 a 4.5,4.5 0 1,0 -9,0 z"
            android:fillColor="#FF8FA3FF" />
    </group>
</vector>
