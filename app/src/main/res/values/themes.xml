<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Base theme is deliberately a bare Material 3 shell: all real colour comes
      from the Compose theme (core/designsystem), so there is only one source of
      truth for the palette. This theme exists to host the platform splash.
    -->
    <style name="Theme.ProcessLens" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/splash_background</item>
    </style>

    <!--
      Section 51: a short premium splash with a subtle lens animation that must
      not delay startup. androidx.core.splashscreen backports the API 31 splash
      to API 23+, so the same 900 ms lens draw-on plays across the whole 26-34+
      range instead of only on Android 12+.
    -->
    <style name="Theme.ProcessLens.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_lens_animated</item>
        <item name="windowSplashScreenAnimationDuration">900</item>
        <item name="postSplashScreenTheme">@style/Theme.ProcessLens</item>
    </style>
</resources>
